# --- Environment ---
ENV=dev                                       # dev | staging | prod
LOG_LEVEL=INFO

# --- Database (Neon Postgres in prod) ---
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/shoebox_db

# --- Redis (Upstash in prod, brew/docker locally) ---
REDIS_URL=redis://localhost:6379/0

# --- api-sports.io (https://www.api-sports.io/) ---
APISPORTS_KEY=replace_me

# --- QStash (Upstash) ---
QSTASH_TOKEN=
QSTASH_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_BASE_URL=https://api.shoebox.app       # used to register cron webhooks

# --- Supabase Auth ---
# Verification uses the project's JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json). No shared secret needed.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- RevenueCat (server-side: webhook + REST API) ---
REVENUECAT_SECRET_API_KEY=sk_...

# --- Sentry ---
SENTRY_DSN=

# --- Scope defaults ---
DEFAULT_SEASON=2025
TARGET_LEAGUES_FOOTBALL=25
TARGET_LEAGUES_BASKETBALL=6
