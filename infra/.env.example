# Copy to `infra/.env` on the VPS — never committed.
#
# Each value is read by `docker-compose.prod.yml` at `docker compose up` time.
# Anything not listed here falls back to the dev defaults baked into the
# backend `Settings` class.

# --- Postgres (internal to the docker network, not exposed to the host) ---
# Strong password please — set once, store in your password manager.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
POSTGRES_DB=shoebox_db

# --- api-sports.io ---
APISPORTS_KEY=

# --- Supabase Auth ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- RevenueCat (server-side webhook + REST) ---
REVENUECAT_SECRET_API_KEY=sk_...

# --- QStash / cron webhooks (set once we add scheduled jobs) ---
QSTASH_TOKEN=
QSTASH_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_BASE_URL=https://api.shoebox.app

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Scope defaults (override if your league list changes) ---
DEFAULT_SEASON=2025
TARGET_LEAGUES_FOOTBALL=25
TARGET_LEAGUES_BASKETBALL=6
